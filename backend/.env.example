# ─────────────────────────────────────────────────────────────────────────────
# WeekFive backend — environment variables
# Copy to `.env` for local dev, or set these in the Render dashboard for prod.
# ─────────────────────────────────────────────────────────────────────────────

# Turso (libSQL) — production database.
# Get these from the Turso dashboard (https://turso.tech) after creating a DB:
#   turso db show <name> --url        -> TURSO_DATABASE_URL (libsql://...)
#   turso db tokens create <name>     -> TURSO_AUTH_TOKEN
# Leave BOTH empty for local dev — the app falls back to a local file
# (backend/weekfive.db), so `npm run dev` works with no credentials.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Secret used to sign JWT auth tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Secret guarding the admin endpoint: GET /api/admin/users?secret=...
ADMIN_SECRET=change-me

# Deployed frontend origin (Vercel) — allowed by CORS.
# Any *.vercel.app origin is already allowed; set this for a custom domain.
FRONTEND_URL=https://your-frontend.vercel.app

# Port. Render provides this automatically; only needed locally (defaults to 5001).
PORT=5001
